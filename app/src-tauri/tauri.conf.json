{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocQA",
  "version": "0.1.0",
  "identifier": "app.localdocqa.desktop",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "windows": [
      { "title": "폐쇄망 문서 Q&A", "width": 1200, "height": 800, "minWidth": 720, "minHeight": 520 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
